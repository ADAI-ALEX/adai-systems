# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private recon notes (this repo is public)
*.private.md

# reference screenshots of other people's sites: local only
/references/**/*.png
/references/**/*.jpg
/references/**/*.jpeg
/references/**/*.webp

# playwright output
/test-results

# installed agent skills (third-party code; restore from skills-lock.json)
/.agents
/.claude

# large review screenshots: regenerate with scripts/shoot.mjs
/design/screenshots/*-768.jpg
/design/screenshots/*-390.jpg
