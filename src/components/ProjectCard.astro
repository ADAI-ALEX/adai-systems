---
import type { Project } from '@/content/projects';
import StatusPill from './StatusPill.astro';
import Plate from './Plate.astro';
interface Props { project: Project; size?: 's' | 'l'; headingLevel?: 'h2' | 'h3'; lazy?: boolean }
const { project, size = 's', headingLevel: H = 'h3', lazy = true } = Astro.props;
const media = project.video ? { src: project.video.poster, alt: project.video.label, width: project.video.width, height: project.video.height, type: 'screen' as const } : project.media?.[0];
---
<article class:list={['card', `card--${size}`]} data-hue={project.aspect ?? undefined} data-reveal data-kind={project.kind} data-status={project.status} data-open={project.openSource ? '1' : undefined}>
  <a class="card-link" href={`/work/${project.slug}`}>
    <div class:list={['card-media', media?.type === 'phone' && 'is-phone', media?.type === 'pixel' && 'is-pixel']}>
      {media ? (
        <img src={media.src} alt={media.alt} width={media.width} height={media.height} loading={lazy ? 'lazy' : 'eager'} decoding="async" />
      ) : (
        <Plate project={project} size={size} />
      )}
      {media?.type === 'concept' && <span class="concept mono">Concept illustration</span>}
    </div>
    <div class="card-body">
      <div class="meta"><StatusPill project={project} /><span class="mono mute">{project.dateLabel}</span></div>
      <H class="card-title">{project.title}</H>
      <p class="mute">{project.pitch}</p>
      <ul class="tags">{project.stack.slice(0, size === 'l' ? 5 : 3).map((s) => <li class="pill pill--plain">{s}</li>)}</ul>
    </div>
  </a>
</article>
<style>
  .card { position: relative; border-radius: var(--radius-l); background: var(--ink-1); border: 1px solid var(--line); overflow: hidden; transition: border-color var(--dur-2), transform var(--dur-3) var(--ease-out); }
  .card:hover { border-color: color-mix(in srgb, var(--hue) 55%, transparent); transform: translateY(-4px); }
  .card-link { display: grid; height: 100%; text-decoration: none; color: inherit; }
  .card-media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--ink-2); border-bottom: 1px solid var(--line); }
  .card--l .card-media { aspect-ratio: 16 / 9; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 900ms var(--ease-out); }
  .card:hover .card-media img { transform: scale(1.035); }
  .card-media.is-phone { display: grid; place-items: center; background: radial-gradient(80% 80% at 50% 100%, color-mix(in srgb, var(--hue) 22%, transparent), transparent), var(--ink-2); }
  .card-media.is-phone img { width: auto; height: 88%; margin-top: 6%; object-fit: contain; border-radius: 18px; box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.8); }
  .card-media.is-pixel img { image-rendering: pixelated; object-fit: cover; }
  .concept { position: absolute; left: 0.75rem; bottom: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 6px; background: rgb(0 0 0 / 0.6); }
  .card-body { display: grid; gap: 0.6rem; padding: clamp(1rem, 0.8rem + 0.8vw, 1.6rem); align-content: start; }
  .meta { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .card-title { font-size: var(--step-2); }
  .card--l .card-title { font-size: var(--step-3); }
  .card-link:focus-visible { outline-offset: -3px; border-radius: var(--radius-l); }
</style>
