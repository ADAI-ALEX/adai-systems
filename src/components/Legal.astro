---
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<section class="legal">
  <div class="wrap narrow">
    <p class="mono mute">Last updated {updated}</p>
    <h1>{title}</h1>
    <div class="intro"><slot name="intro" /></div>
    <div class="prose"><slot /></div>
  </div>
</section>
<style>
  .legal { padding: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 5rem)) 0 clamp(4rem, 3rem + 4vw, 7rem); }
  .narrow { max-width: 760px; }
  h1 { font-size: var(--step-4); margin: 0.75rem 0 1.5rem; }
  .intro { font-size: var(--step-1); color: var(--bone-dim); margin-bottom: 2.5rem; }
  .prose :global(h2) { font-size: var(--step-2); margin: 2.5rem 0 0.9rem; }
  .prose :global(p) { color: var(--bone-dim); margin-bottom: 1rem; }
  .prose :global(a) { color: var(--bone); }
</style>
