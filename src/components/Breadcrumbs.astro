---
interface Props { items: { name: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs mono" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>{item.href && i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; color: var(--mute); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; opacity: 0.5; }
  .crumbs a { color: var(--bone-dim); text-decoration: none; }
  .crumbs a:hover { color: var(--bone); text-decoration: underline; }
</style>
