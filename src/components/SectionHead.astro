---
interface Props { eyebrow?: string; title: string; lead?: string; as?: 'h1' | 'h2'; id?: string; align?: 'start' | 'center' }
const { eyebrow, title, lead, as: Tag = 'h2', id, align = 'start' } = Astro.props;
---
<header class:list={['section-head', `align-${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
<style>
  .section-head { display: grid; gap: 1rem; max-width: 52rem; margin-bottom: clamp(2rem, 1.4rem + 2vw, 3.5rem); }
  .align-center { margin-inline: auto; text-align: center; justify-items: center; }
  .align-center .lead { margin-inline: auto; }
  .lead { max-width: 46ch; }
</style>
