---
/** A typographic plate for projects with no images: never a fake screenshot. */
import type { Project } from '@/content/projects';
interface Props { project: Project; size?: 's' | 'l' }
const { project, size = 's' } = Astro.props;
---
<div class:list={['plate', `plate--${size}`]} data-hue={project.aspect ?? undefined} role="img" aria-label={`${project.title}: ${project.pitch}`}>
  <span class="mono">{project.kindLabel} · {project.dateLabel}</span>
  <strong>{project.title}</strong>
  <span class="pitch">{project.pitch}</span>
</div>
<style>
  .plate { position: relative; display: grid; align-content: end; gap: 0.5rem; width: 100%; height: 100%; min-height: 220px; padding: clamp(1rem, 0.8rem + 1vw, 1.75rem); overflow: hidden;
    background: radial-gradient(120% 90% at 85% 0%, color-mix(in srgb, var(--hue) 22%, transparent), transparent 60%), repeating-linear-gradient(0deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 14px), var(--ink-2); }
  .plate .mono { color: var(--hue); }
  .plate strong { font-size: var(--step-3); font-weight: 650; font-stretch: 120%; letter-spacing: -0.035em; line-height: 1; }
  .plate--s strong { font-size: var(--step-2); }
  .pitch { color: var(--bone-dim); max-width: 34ch; }
</style>
