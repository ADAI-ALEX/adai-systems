---
/** Real captures only: Lockout (on the App Store) and Margin (live, open source). */
import { getProject } from '@/content/projects';
const lockout = getProject('lockout');
const margin = getProject('margin');
const phones = (lockout.media ?? []).filter((m) => m.type === 'phone').slice(0, 5);
const web = (margin.media ?? []).slice(0, 4);
---
<div class="demo apps panel" data-hue="products" data-apps-demo>
  <div class="demo-bar">
    <div class="tabs" role="tablist" aria-label="Product">
      <button role="tab" aria-selected="true" aria-controls="apps-lockout" id="tab-lockout" data-tab="lockout">Lockout · iPhone</button>
      <button role="tab" aria-selected="false" aria-controls="apps-margin" id="tab-margin" data-tab="margin" tabindex="-1">Margin · web</button>
    </div>
    <span class="pill">Real captures</span>
  </div>

  <div class="view" id="apps-lockout" role="tabpanel" aria-labelledby="tab-lockout" data-view="lockout">
    <div class="phones">
      {phones.map((m, i) => (
        <figure class="phone-wrap" style={`--i:${i}`}>
          <div class="phone"><img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" /></div>
        </figure>
      ))}
    </div>
    <p class="caption">{lockout.pitch} <a href="/work/lockout" class="link-arrow">Case study <span aria-hidden="true">→</span></a></p>
  </div>

  <div class="view" id="apps-margin" role="tabpanel" aria-labelledby="tab-margin" data-view="margin" hidden>
    <div class="browser">
      <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span class="mono">margin.adai.systems</span></div>
      <div class="shots" data-shots>
        {web.map((m, i) => <img src={m.src} alt={m.alt} width={m.width} height={m.height} loading="lazy" decoding="async" class:list={[{ active: i === 0 }]} />)}
      </div>
    </div>
    <div class="dots" role="group" aria-label="Margin screens">
      {web.map((_m, i) => <button type="button" aria-label={`Show screen ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-shot={i}></button>)}
    </div>
    <p class="caption">{margin.pitch} <a href="/work/margin" class="link-arrow">Case study <span aria-hidden="true">→</span></a></p>
  </div>
</div>
<style>
  .demo { padding: clamp(1rem, 0.8rem + 1vw, 1.75rem); display: grid; gap: 1.25rem; }
  .demo-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .tabs { display: inline-flex; padding: 4px; border-radius: 999px; background: var(--ink-2); border: 1px solid var(--line); }
  .tabs button { min-height: 40px; padding: 0 1rem; border-radius: 999px; border: 0; background: transparent; color: var(--bone-dim); cursor: pointer; font-weight: 560; font-size: 0.92rem; }
  .tabs button[aria-selected='true'] { background: var(--hue); color: var(--ink-0); }
  .phones { display: flex; justify-content: center; gap: clamp(0.4rem, 1vw, 1rem); padding-block: 1rem 0.5rem; perspective: 1400px; }
  .phone-wrap { margin: 0; width: clamp(96px, 17%, 170px); transform: translateY(calc(var(--i) * 0px)) rotateY(calc((var(--i) - 2) * -6deg)); transition: transform 800ms var(--ease-out); }
  .phone-wrap:nth-child(odd) { transform: translateY(18px) rotateY(calc((var(--i) - 2) * -6deg)); }
  .phones:hover .phone-wrap { transform: none; }
  .phone { border-radius: 22px; padding: 5px; }
  .phone img { border-radius: 17px; }
  .browser { border-radius: 16px; overflow: hidden; border: 1px solid var(--line-strong); background: var(--ink-2); box-shadow: 0 40px 60px -40px rgb(0 0 0 / 0.9); }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--line); }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: var(--ink-3); }
  .chrome span { margin-left: 0.75rem; font-size: 0.72rem; color: var(--mute); }
  .shots { position: relative; aspect-ratio: 16 / 10; }
  .shots img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; opacity: 0; transition: opacity 600ms var(--ease-out); }
  .shots img.active { opacity: 1; }
  .dots { display: flex; gap: 0.5rem; justify-content: center; }
  .dots button { width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .dots button::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); transition: background-color var(--dur-2), transform var(--dur-2); }
  .dots button[aria-pressed='true']::before { background: var(--hue); transform: scale(1.3); }
  .caption { color: var(--bone-dim); display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: baseline; }
</style>
<script>
  import { mascot } from '@/scripts/mascot-bus';
  const root = document.querySelector<HTMLElement>('[data-apps-demo]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (key: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === key;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      root.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== key));
      mascot({ expression: 'proud', hold: 1.4, gesture: 'present' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
          select(next.dataset.tab!, true);
        }
      });
    });
    const shots = [...root.querySelectorAll<HTMLImageElement>('[data-shots] img')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    dots.forEach((d, i) => d.addEventListener('click', () => {
      shots.forEach((s, j) => s.classList.toggle('active', i === j));
      dots.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
    }));
  }
</script>
