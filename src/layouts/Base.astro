---
import '@/styles/global.css';
import monaWoff2 from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/content/site';
import { absolute, organizationLd, webPageLd, websiteLd } from '@/lib/seo';

export interface MascotStageConfig {
  /** story: home page choreography driven by [data-mascot-section]; hero: one pose near the top; */
  mode: 'story' | 'hero';
  /** Default pose / expression id (see src/gl/mascot/poses.ts). */
  pose?: string;
  /** Aspect hue for the mascot's core light. */
  hue?: 'signature' | 'agents' | 'automation' | 'products' | 'research' | 'studio';
  /** Which side of the viewport the mascot occupies in hero mode. */
  side?: 'left' | 'right' | 'center';
}

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  hue?: string;
  mascot?: MascotStageConfig;
  jsonLd?: object[];
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, path, ogImage = '/og/home.png', hue, mascot, jsonLd = [], noindex = false, bodyClass } = Astro.props;
const fullTitle = path === '/' ? `${site.name}: ${site.headline.replace(/\.$/, '')}` : `${title} | ${site.name}`;
const canonical = absolute(path);
const ld = [organizationLd(), websiteLd(), ...(noindex ? [] : [webPageLd({ path, title: fullTitle, description, image: ogImage })]), ...jsonLd];
const ogAlt = `${site.name}: ${path === '/' ? site.headline : title}`;
---
<!doctype html>
<html lang="en-GB" data-hue={hue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#06080b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={monaWoff2} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(ogImage)} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    {mascot && (
      <div
        class="gl-stage"
        data-gl-stage
        data-mode={mascot.mode}
        data-pose={mascot.pose ?? 'idle'}
        data-hue={mascot.hue ?? 'signature'}
        data-side={mascot.side ?? 'right'}
        aria-hidden="true"
      ></div>
    )}
    <div class="grain" aria-hidden="true"></div>
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/site';
    </script>
    {mascot && (
      <script>
        import { bootWhenReady } from '@/scripts/gl-loader';
        bootWhenReady();
      </script>
    )}
  </body>
</html>
