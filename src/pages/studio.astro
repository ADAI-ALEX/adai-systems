---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import MascotAnchor from '@/components/MascotAnchor.astro';
import HireBand from '@/components/HireBand.astro';
import { byDate, counts, domains, getProject } from '@/content/projects';
import { copy, site } from '@/content/site';
import { breadcrumbLd } from '@/lib/seo';
---
<Base
  title="Studio"
  path="/studio"
  description={`${site.name} is an independent technology studio run by Alex, founded in ${site.founded}. Every project since then, in order, and how one led to the next.`}
  ogImage="/og/studio.png"
  mascot={{ mode: 'hero', pose: 'intro' }}
  jsonLd={[breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Studio', path: '/studio' }])]}
>
  <section class="page-hero">
    <div class="wrap hero-grid">
      <div class="stack" style="--stack:1.25rem">
        <p class="eyebrow" data-reveal>Studio</p>
        <h1 data-reveal>{site.line}</h1>
        <p class="lead" data-reveal>{copy.hire.body}</p>
        <dl class="facts" data-reveal>
          <div><dt>Founded</dt><dd>{site.founded}</dd></div>
          <div><dt>Projects</dt><dd>{counts.total}</dd></div>
          <div><dt>Running today</dt><dd>{counts.running}</dd></div>
          <div><dt>Open source</dt><dd>{counts.openSource}</dd></div>
        </dl>
        <p class="mono mute">{site.operator}</p>
      </div>
      <MascotAnchor pose="intro" class="page-mascot" eager />
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <div class="wrap">
      <SectionHead id="timeline-title" title="One thing led to the next" lead="Every project in the order it started, with the work it grew out of." />
      <ol class="timeline">
        {byDate.map((p) => (
          <li class="t-item" data-hue={p.aspect} data-reveal>
            <span class="t-date mono">{p.dateLabel}</span>
            <span class="t-dot" aria-hidden="true"></span>
            <a class="t-card" href={`/work/${p.slug}`}>
              <span class="mono mute">{p.chapter} · {p.statusLabel}</span>
              <strong>{p.title}</strong>
              <span class="mute">{p.pitch}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="domains-title">
    <div class="wrap">
      <SectionHead id="domains-title" title="Where the work sits" />
      <div class="grid domains">
        {domains.map((d) => (
          <article class="domain panel" data-reveal>
            <h3>{d.label}</h3>
            <p class="mute">{d.note}</p>
            <ul class="tags">{d.slugs.map((s) => <li><a class="pill pill--plain" href={`/work/${s}`}>{getProject(s).title}</a></li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <HireBand />
</Base>
<style>
  .page-hero { padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 5rem)); }
  .hero-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.35fr 0.65fr; } }
  :global(.page-mascot) { height: 460px; }
  @media (max-width: 899px) { :global(.page-mascot) { height: 260px; order: -1; } }
  .facts { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; margin: 0.5rem 0; padding: 1.25rem 0; border-block: 1px solid var(--line); }
  .facts dt { font-family: var(--font-mono); font-size: 0.72rem; color: var(--mute); }
  .facts dd { margin: 0.2rem 0 0; font-size: var(--step-2); font-weight: 640; font-stretch: 118%; }
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 0.75rem; }
  .timeline::before { content: ''; position: absolute; left: 9.25rem; top: 0; bottom: 0; width: 1px; background: linear-gradient(var(--line-strong), var(--line)); }
  .t-item { display: grid; grid-template-columns: 8.5rem 1.5rem 1fr; align-items: center; gap: 0.5rem; }
  .t-date { font-size: 0.75rem; color: var(--mute); text-align: right; }
  .t-dot { width: 11px; height: 11px; border-radius: 50%; background: var(--hue); justify-self: center; box-shadow: 0 0 0 4px var(--ink-0), 0 0 18px color-mix(in srgb, var(--hue) 60%, transparent); }
  .t-card { display: grid; gap: 0.2rem; padding: 0.9rem 1.1rem; border-radius: var(--radius-m); border: 1px solid var(--line); text-decoration: none; transition: border-color var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .t-card:hover { border-color: var(--hue); transform: translateX(4px); }
  .t-card strong { font-stretch: 112%; font-size: 1.1rem; }
  @media (max-width: 640px) {
    .timeline::before { left: 0.7rem; }
    .t-item { grid-template-columns: 1.5rem 1fr; }
    .t-date { grid-column: 2; text-align: left; order: -1; }
    .t-dot { grid-row: 1 / span 2; }
  }
  .domains { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .domain { padding: 1.5rem; display: grid; gap: 0.75rem; align-content: start; }
  .domain h3 { font-size: var(--step-1); font-stretch: 112%; }
  .domain .tags a { text-decoration: none; min-height: 32px; }
  .domain .tags a:hover { border-color: var(--bone); color: var(--bone); }
</style>
