</style>

<script>
  import { motionAllowed } from '@/scripts/motion';
  /* The roadmap rail fills as the reader moves through it. Full and static when motion is reduced. */
  const road = document.querySelector<HTMLElement>('[data-road]');
  if (road) {
    const set = (v: number) => road.style.setProperty('--road', v.toFixed(3));
    const update = () => {
      if (!motionAllowed()) return set(1);
      const r = road.getBoundingClientRect();
      const mid = innerHeight * 0.6;
      set(Math.min(1, Math.max(0, (mid - r.top) / r.height)));
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    addEventListener('adai:motion', update);
    update();
  }
</script>
